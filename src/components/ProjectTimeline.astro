---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface ProjectEntry {
  slug: string;
  title: string;
  year: string;
  isGroupProject: boolean;
  coverImage: ImageMetadata;
  coverImageAlt: string;
  description: string;
}

interface Props {
  entries: ProjectEntry[];
}

const { entries } = Astro.props;
---

<ol class="project-timeline">
  {entries.map((entry) => (
    <li class="project-timeline__entry">
      <span
        class={`project-timeline__marker ${entry.isGroupProject ? 'project-timeline__marker--half' : ''}`}
        aria-hidden="true"
      ></span>
      <div class="project-timeline__body">
        <a href={`/projects/${entry.slug}`} class="project-timeline__link">
          <span class="project-timeline__title">{entry.title}</span>
          <span class="project-timeline__year">
            {entry.year}
            {entry.isGroupProject && <> · group project</>}
          </span>
        </a>
        <div class="project-timeline__preview" data-reveal>
          <Image
            src={entry.coverImage}
            alt={entry.coverImageAlt}
            width={640}
            class="project-timeline__preview-img"
          />
          <p class="project-timeline__preview-text">{entry.description}</p>
          <a href={`/projects/${entry.slug}`} class="project-timeline__preview-link">View project →</a>
        </div>
      </div>
    </li>
  ))}
</ol>

<script>
  // Each preview starts visible (progressive enhancement: if this script
  // doesn't run, everything is just shown), then this hides it and reveals
  // it again as it scrolls into view, so the page reads as one continuous
  // scroll of titles and previews rather than requiring a click per project.
  const previews = document.querySelectorAll<HTMLElement>('.project-timeline__preview[data-reveal]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (previews.length > 0 && !prefersReducedMotion && 'IntersectionObserver' in window) {
    previews.forEach((preview) => preview.classList.add('project-timeline__preview--pending'));

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('project-timeline__preview--visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
    );

    previews.forEach((preview) => observer.observe(preview));
  }
</script>

<style>
  /*
    A half-filled marker means the project was made with collaborators
    (derived from that project's own `collaborators` frontmatter, not a
    separate field) - spelled out in the text too, per the same rule as
    the About page timeline, so the marker shape alone isn't the only
    way to know what it means.
  */
  .project-timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-timeline::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.6em;
    bottom: 0;
    width: 1px;
    background: var(--color-border);
    transform: translateX(-50%);
  }

  .project-timeline__entry {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-1);
  }

  .project-timeline__entry:first-child {
    padding-top: 0;
  }

  .project-timeline__entry:last-child {
    padding-bottom: 0;
  }

  .project-timeline__marker {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-text);
    position: relative;
    z-index: 1;
  }

  .project-timeline__marker--half {
    background: conic-gradient(var(--color-text) 0deg 180deg, var(--color-border) 180deg 360deg);
  }

  .project-timeline__body {
    flex: 1;
    min-width: 0;
  }

  .project-timeline__link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    text-decoration: none;
  }

  .project-timeline__title {
    font-size: var(--font-size-lg);
    font-weight: 600;
  }

  .project-timeline__year {
    color: var(--color-muted);
    font-size: var(--font-size-sm);
  }

  .project-timeline__preview {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 24rem;
    margin-top: var(--space-2);
    padding-bottom: var(--space-2);
  }

  .project-timeline__preview-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .project-timeline__preview-text {
    color: var(--color-text);
  }

  .project-timeline__preview-link {
    align-self: flex-start;
    font-size: var(--font-size-sm);
  }

  .project-timeline__preview--pending {
    opacity: 0;
    transform: translateY(0.75rem);
    transition: opacity 400ms ease-out, transform 400ms ease-out;
  }

  .project-timeline__preview--pending.project-timeline__preview--visible {
    opacity: 1;
    transform: none;
  }
</style>
