---
interface Props {
  color?: string;
  class?: string;
}

const { color = 'var(--color-text)', class: className } = Astro.props;
---

<nav class:list={['reading-stepper', className]} aria-label="reading depth" style={`--stepper-color: ${color};`}>
  <button type="button" data-step="preview">
    <span class="reading-stepper__icon" aria-hidden="true">
      <svg viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="8" class="reading-stepper__track"></circle>
        <path d="M8 8 L8 0 A8 8 0 0 1 16 8 Z" class="reading-stepper__fill"></path>
      </svg>
    </span>
    <span class="reading-stepper__label">Preview</span>
  </button>
  <span class="reading-stepper__connector" aria-hidden="true"></span>
  <button type="button" data-step="collage">
    <span class="reading-stepper__icon" aria-hidden="true">
      <svg viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="8" class="reading-stepper__track"></circle>
        <path d="M8 0 A8 8 0 0 1 8 16 Z" class="reading-stepper__fill"></path>
      </svg>
    </span>
    <span class="reading-stepper__label">Collage</span>
  </button>
  <span class="reading-stepper__connector" aria-hidden="true"></span>
  <button type="button" data-step="full">
    <span class="reading-stepper__icon" aria-hidden="true">
      <svg viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="8" class="reading-stepper__fill"></circle>
      </svg>
    </span>
    <span class="reading-stepper__label">Full project</span>
  </button>
</nav>

<style>
  .reading-stepper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }

  .reading-stepper button {
    all: unset;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .reading-stepper__icon {
    display: block;
    width: 11px;
    height: 11px;
    flex-shrink: 0;
  }

  .reading-stepper__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .reading-stepper__track {
    fill: var(--color-border);
  }

  .reading-stepper__fill {
    fill: var(--color-border);
  }

  .reading-stepper button[aria-current='true'] .reading-stepper__fill {
    fill: var(--stepper-color);
  }

  .reading-stepper__label {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .reading-stepper button[aria-current='true'] .reading-stepper__label {
    color: var(--color-text);
    font-weight: 600;
  }

  .reading-stepper button:not([aria-current='true']):hover .reading-stepper__label {
    color: var(--color-text);
  }

  .reading-stepper__connector {
    width: 2rem;
    height: 1px;
    background: var(--color-border);
  }
</style>
