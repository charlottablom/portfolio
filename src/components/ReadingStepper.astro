---
interface Props {
  color?: string;
  class?: string;
  vertical?: boolean;
}

const { color = 'var(--color-text)', class: className, vertical = false } = Astro.props;
---

<nav
  class:list={['reading-stepper', { 'reading-stepper--vertical': vertical }, className]}
  aria-label="reading depth"
  style={`--stepper-color: ${color};`}
>
  <button type="button" data-step="preview" title="Preview">
    <span class="reading-stepper__icon" aria-hidden="true">
      <svg viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="8" class="reading-stepper__track"></circle>
        <path d="M8 8 L8 0 A8 8 0 0 1 16 8 Z" class="reading-stepper__fill"></path>
      </svg>
    </span>
    <span class="reading-stepper__label">Preview</span>
  </button>
  <span class="reading-stepper__connector" aria-hidden="true"></span>
  <button type="button" data-step="collage" title="Collage">
    <span class="reading-stepper__icon" aria-hidden="true">
      <svg viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="8" class="reading-stepper__track"></circle>
        <path d="M8 0 A8 8 0 0 1 8 16 Z" class="reading-stepper__fill"></path>
      </svg>
    </span>
    <span class="reading-stepper__label">Collage</span>
  </button>
  <span class="reading-stepper__connector" aria-hidden="true"></span>
  <button type="button" data-step="full" title="Full project">
    <span class="reading-stepper__icon" aria-hidden="true">
      <svg viewBox="0 0 16 16">
        <circle cx="8" cy="8" r="8" class="reading-stepper__fill"></circle>
      </svg>
    </span>
    <span class="reading-stepper__label">Full project</span>
  </button>
</nav>

<style>
  .reading-stepper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding-block: var(--space-3);
  }

  .reading-stepper button {
    all: unset;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .reading-stepper__icon {
    display: block;
    width: 11px;
    height: 11px;
    flex-shrink: 0;
  }

  .reading-stepper__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .reading-stepper__track {
    fill: var(--color-border);
  }

  .reading-stepper__fill {
    fill: var(--color-border);
  }

  .reading-stepper button[aria-current='true'] .reading-stepper__fill {
    fill: var(--stepper-color);
  }

  .reading-stepper__label {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .reading-stepper button[aria-current='true'] .reading-stepper__label {
    color: var(--color-text);
    font-weight: 600;
  }

  .reading-stepper button:not([aria-current='true']):hover .reading-stepper__label {
    color: var(--color-text);
  }

  .reading-stepper__connector {
    width: 2rem;
    height: 1px;
    background: var(--color-border);
  }

  /*
    Compact, icon-only version for a fixed position on the side of the
    viewport, so switching steps never requires scrolling back to the
    top - see [slug].astro. Labels stay in the DOM (for screen readers
    and the hover title) but are visually hidden rather than removed,
    since there isn't room for them in a slim fixed sidebar.
  */
  .reading-stepper--vertical {
    flex-direction: column;
    gap: var(--space-2);
    padding-block: 0;
  }

  .reading-stepper--vertical .reading-stepper__connector {
    width: 1px;
    height: 1.25rem;
  }

  .reading-stepper--vertical .reading-stepper__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
