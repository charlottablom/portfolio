---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Circle from '../components/Circle.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { featuredProjects } from '../config/featured-projects';
import { careerStages } from '../content.config';

const allProjects = await getCollection('projects');

const projects =
  featuredProjects.length === 0
    ? allProjects
    : featuredProjects
        .map((slug) => allProjects.find((project) => project.id === slug))
        .filter((project) => project !== undefined);

// Themes are derived from whatever's actually on this page, not a fixed
// list, so the filter stays accurate as projects (and their themes)
// change - no hierarchy between them, so options are just alphabetical.
const themes = [...new Set(projects.flatMap((project) => project.data.themes))].sort();

const careerStageLabels: Record<(typeof careerStages)[number], string> = {
  bachelor: 'Bachelor',
  master: 'Master',
  practice: 'Applied in Practice',
};

// Grouped by career stage, most recent project first within each group -
// mirrors the "most recent at top" convention used by the About page
// timeline.
const isCurated = featuredProjects.length > 0;

// Deterministic per-project horizontal offset for the preview image, so
// the list reads with some visual rhythm instead of a strict grid, but
// the same project always lands in the same place rather than shifting
// on every rebuild. Weighted toward the right, since the container has
// far more room there than in the left gutter.
const previewOffsets = [4, 24, 38, 14, -4, 44, 20, 32, -6, 28];
function previewOffsetFor(slug: string) {
  let hash = 0;
  for (let i = 0; i < slug.length; i++) {
    hash = (hash * 31 + slug.charCodeAt(i)) >>> 0;
  }
  return previewOffsets[hash % previewOffsets.length];
}

const groups = careerStages
  .map((stage) => ({
    stage,
    label: careerStageLabels[stage],
    projects: projects
      .filter((project) => project.data.careerStage === stage)
      .sort((a, b) => Number(b.data.year) - Number(a.data.year)),
  }))
  // On a curated (e.g. job-application) branch, a stage with nothing
  // selected isn't "coming soon" - it just wasn't picked for this view,
  // so skip it rather than showing the empty-state placeholder.
  .filter((group) => group.projects.length > 0 || !isCurated);
---

<Layout title="Projects — Charlotta Blom" description="Selected projects by Charlotta Blom.">
	<PageIntro title="Projects" circleRotation={180} />

	<section class="projects container">
		{projects.length === 0 ? (
			<p class="projects__empty">Projects will be added here.</p>
		) : (
			<>
				{themes.length > 1 && !isCurated && (
					<div class="projects__filter" role="group" aria-label="Filter by theme">
						<button type="button" class="projects__filter-chip" data-theme-all aria-pressed="true">
							All
						</button>
						{themes.map((theme) => (
							<button type="button" class="projects__filter-chip" data-theme={theme} aria-pressed="false">
								{theme}
							</button>
						))}
					</div>
				)}

				{groups.map((group) => (
					<section class="projects__group" data-group={group.stage}>
						<h2 class="projects__group-title">{group.label}</h2>
						{group.projects.length === 0 ? (
							<p class="projects__empty">Projects will be added here.</p>
						) : (
							<ul class="projects__list">
								{group.projects.map((project) => (
									<li class="projects__item" data-themes={project.data.themes.join('|')}>
										<a
										href={`/projects/${project.id}`}
										style={`--preview-offset: ${previewOffsetFor(project.id)}rem;`}
									>
											<span class="projects__item-title">
												{project.data.accentColor && (
													<Circle
														full
														size="0.5rem"
														color={project.data.accentColor}
														class="projects__item-dot"
													/>
												)}
												{project.data.title}
											</span>
											<span class="projects__item-meta">
												{project.data.subtitle} — {project.data.year}
											</span>
											<div class="projects__preview" data-reveal>
												<span class="projects__preview-image-wrap">
													<Image
														src={project.data.previewImage ?? project.data.coverImage}
														alt={project.data.previewImageAlt ?? project.data.coverImageAlt}
														width={1200}
														class="projects__preview-img"
													/>
													<span class="projects__preview-click-tint" aria-hidden="true"></span>
												</span>
												<p class="projects__preview-text">{project.data.description}</p>
											</div>
										</a>
									</li>
								))}
							</ul>
						)}
					</section>
				))}

				<p class="projects__no-match" hidden>No projects match the selected themes.</p>
			</>
		)}
	</section>
</Layout>

<script>
  // Same scroll-reveal as the Home page preview list: each project's
  // preview starts visible (progressive enhancement), then this hides it
  // and fades it back in as it scrolls into view.
  const previews = document.querySelectorAll<HTMLElement>('.projects__preview[data-reveal]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (previews.length > 0 && !prefersReducedMotion && 'IntersectionObserver' in window) {
    previews.forEach((preview) => preview.classList.add('projects__preview--pending'));

    const revealObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('projects__preview--visible');
            revealObserver.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.15 },
    );

    previews.forEach((preview) => revealObserver.observe(preview));
  }

  // Group headings (Applied in Practice / Master / Bachelor) fade out as
  // they scroll through the upper half of the viewport: fully visible
  // below the vertical midpoint, dissolving to transparent by the time
  // they reach the top edge, rather than an abrupt show/hide.
  const groupTitles = document.querySelectorAll<HTMLElement>('.projects__group-title');

  if (groupTitles.length > 0 && !prefersReducedMotion) {
    let ticking = false;

    const updateGroupTitleFade = () => {
      const viewportMid = window.innerHeight / 2;
      groupTitles.forEach((title) => {
        const top = title.getBoundingClientRect().top;
        const opacity = top >= viewportMid ? 1 : Math.max(0, Math.min(1, top / viewportMid));
        title.style.opacity = String(opacity);
      });
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateGroupTitleFade);
          ticking = true;
        }
      },
      { passive: true },
    );

    updateGroupTitleFade();
  }

  const filterGroup = document.querySelector<HTMLElement>('.projects__filter');

  if (filterGroup) {
    const allButton = filterGroup.querySelector<HTMLButtonElement>('[data-theme-all]');
    const themeButtons = filterGroup.querySelectorAll<HTMLButtonElement>('[data-theme]');
    const groups = document.querySelectorAll<HTMLElement>('.projects__group');
    const noMatch = document.querySelector<HTMLElement>('.projects__no-match');
    const active = new Set<string>();

    const applyFilter = () => {
      let visibleCount = 0;
      groups.forEach((group) => {
        const items = group.querySelectorAll<HTMLElement>('.projects__item');
        let groupVisible = 0;
        items.forEach((item) => {
          const itemThemes = (item.dataset.themes ?? '').split('|');
          const show = active.size === 0 || itemThemes.some((theme) => active.has(theme));
          item.hidden = !show;
          if (show) {
            groupVisible += 1;
            visibleCount += 1;
          }
        });
        // Groups with no items yet (e.g. an empty Applied in Practice) have
        // nothing to filter, so leave their placeholder text showing.
        if (items.length > 0) {
          group.hidden = groupVisible === 0;
        }
      });
      if (noMatch) noMatch.hidden = visibleCount > 0;
    };

    allButton?.addEventListener('click', () => {
      active.clear();
      allButton.setAttribute('aria-pressed', 'true');
      themeButtons.forEach((button) => button.setAttribute('aria-pressed', 'false'));
      applyFilter();
    });

    themeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const theme = button.dataset.theme ?? '';
        if (active.has(theme)) {
          active.delete(theme);
          button.setAttribute('aria-pressed', 'false');
        } else {
          active.add(theme);
          button.setAttribute('aria-pressed', 'true');
        }
        allButton?.setAttribute('aria-pressed', String(active.size === 0));
        applyFilter();
      });
    });
  }
</script>

<style>
  .projects {
    padding-block: var(--space-4);
    /*
      Wider than the site's usual reading-width container: this page is
      a scannable list rather than a block of prose, so it uses more of
      the viewport instead of leaving large empty margins either side.
    */
    max-width: 100rem;
  }

  .projects__empty,
  .projects__no-match {
    color: var(--color-muted);
  }

  .projects__filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-bottom: var(--space-4);
  }

  .projects__filter-chip {
    border: 1px solid var(--color-border);
    background: none;
    color: var(--color-text);
    font: inherit;
    font-size: var(--font-size-sm);
    padding: var(--space-0) var(--space-2);
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
  }

  .projects__filter-chip:hover {
    border-color: var(--color-text);
  }

  .projects__filter-chip[aria-pressed='true'] {
    background: var(--color-text);
    color: var(--color-background);
    border-color: var(--color-text);
  }

  .projects__group + .projects__group {
    margin-top: var(--space-4);
  }

  .projects__group-title {
    margin-bottom: var(--space-2);
  }

  /*
    Column, not row-with-wrap: a short title (Kyrktornet) left enough
    room for the meta line to sit beside it instead of below, unlike the
    longer titles - stacking unconditionally keeps every item consistent
    regardless of title length.

    max-width caps the whole card - title, meta, and preview together -
    to the preview image's own width, so neither the title nor the
    description text can run wider than the picture beneath them.
  */
  .projects__item a {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    max-width: 40rem;
    padding-block: var(--space-3);
    text-decoration: none;
  }

  /*
    The offset only kicks in once the container is wide enough to have
    spare room beside a 40rem-wide card - below that it would either do
    nothing or risk crowding/overflowing, so it just stays flush left.
  */
  @media (min-width: 60rem) {
    .projects__item a {
      /*
        clamp()'s upper bound is viewport-relative, not a fixed rem value:
        a project's offset should stay proportionally big on a wide
        screen, but automatically shrink on a merely-past-the-breakpoint
        one instead of pushing the card past the container's edge.
      */
      margin-left: clamp(0rem, var(--preview-offset, 0rem), 26vw);
    }
  }

  .projects__item-title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xl);
    font-weight: 600;
  }

  .projects__item-dot {
    display: inline-block;
  }

  .projects__item-meta {
    color: var(--color-muted);
  }

  .projects__preview {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .projects__preview-image-wrap {
    position: relative;
    display: block;
  }

  .projects__preview-img {
    display: block;
    width: 100%;
    height: auto;
  }

  .projects__preview-click-tint {
    position: absolute;
    inset: 0;
    background: #ffffff;
    opacity: 0;
    transition: opacity var(--transition-fast);
    pointer-events: none;
  }

  .projects__item a:active .projects__preview-click-tint {
    opacity: 0.3;
  }

  .projects__preview-text {
    color: var(--color-text);
  }

  .projects__preview--pending {
    opacity: 0;
    transform: translateY(0.75rem);
    transition: opacity 400ms ease-out, transform 400ms ease-out;
  }

  .projects__preview--pending.projects__preview--visible {
    opacity: 1;
    transform: none;
  }
</style>
