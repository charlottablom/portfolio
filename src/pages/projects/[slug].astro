---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import LoadingImage from '../../components/LoadingImage.astro';
import ReadingStepper from '../../components/ReadingStepper.astro';
import ProjectCollage from '../../components/ProjectCollage.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const {
  title,
  subtitle,
  year,
  location,
  projectType,
  role,
  collaborators,
  tools,
  themes,
  description,
  coverImage,
  coverImageAlt,
  accentColor,
  collageImages,
} = project.data;

const coverColor = accentColor;
const hasReadingSteps = collageImages && collageImages.length > 0;

const { Content } = await render(project);
---

<Layout title={`${title} — Charlotta Blom`} description={description}>
	<article class="project" data-has-steps={hasReadingSteps ? '' : undefined}>
		{hasReadingSteps && <ReadingStepper color={accentColor} class="project__stepper container" />}

		{hasReadingSteps && (
			<section class="project__view container" data-view="preview">
				<h1>{title}</h1>
				<p class="project__subtitle">{subtitle}</p>
				<button type="button" class="project__preview-cover-link" data-goto="collage" aria-label="See the collage">
					<LoadingImage
						class="project__preview-cover"
						src={coverImage}
						alt={coverImageAlt}
						width={1600}
						color={coverColor}
					/>
				</button>
				<p class="project__preview-text">{description}</p>
				<button type="button" class="project__advance" data-goto="collage">See the collage →</button>
			</section>
		)}

		{hasReadingSteps && (
			<section class="project__view container" data-view="collage">
				<h1>{title}</h1>
				<p class="project__subtitle">The whole project at a glance. Click any image to open it in the full project.</p>
				<ProjectCollage images={collageImages} />
				<button type="button" class="project__advance project__advance--collage" data-goto="full">See the full project →</button>
			</section>
		)}

		<section class="project__view" data-view="full">
			<header class="project__header container">
				<p class="project__back"><a href="/projects">← Projects</a></p>
				<h1>{title}</h1>
				<p class="project__subtitle">{subtitle}</p>

				<dl class="project__meta">
					<div>
						<dt>Year</dt>
						<dd>{year}</dd>
					</div>
					{location && (
						<div>
							<dt>Location</dt>
							<dd>{location}</dd>
						</div>
					)}
					<div>
						<dt>Type</dt>
						<dd>{projectType}</dd>
					</div>
					<div>
						<dt>Role</dt>
						<dd>{role}</dd>
					</div>
					{collaborators && collaborators.length > 0 && (
						<div>
							<dt>Collaborators</dt>
							<dd>{collaborators.join(', ')}</dd>
						</div>
					)}
					<div>
						<dt>Tools</dt>
						<dd>{tools.join(', ')}</dd>
					</div>
					<div>
						<dt>Themes</dt>
						<dd>{themes.join(', ')}</dd>
					</div>
				</dl>
			</header>

			<LoadingImage
				id="img-cover"
				class="project__cover container"
				src={coverImage}
				alt={coverImageAlt}
				width={1600}
				color={coverColor}
			/>

			<div class="project__body container">
				<Content />
			</div>
		</section>

	</article>

	{hasReadingSteps && (
		<ReadingStepper color={accentColor} vertical class="project__stepper-fixed" />
	)}

	<div class="lightbox" id="project-lightbox" hidden>
		<button type="button" class="lightbox__close" aria-label="Close image">
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M18 6L6 18"></path>
				<path d="M6 6l12 12"></path>
			</svg>
		</button>
		<img class="lightbox__img" src="" alt="" />
	</div>
</Layout>

<script>
  // Same scroll-reveal as the Home page preview list, applied here to each
  // image/video in the project body - visible by default (if this script
  // doesn't run, everything just shows), then hidden and faded back in as
  // it scrolls into view.
  const targets = document.querySelectorAll<HTMLElement>('.project__body .loading-image, .project__body video');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (targets.length > 0 && !prefersReducedMotion && 'IntersectionObserver' in window) {
    targets.forEach((target) => target.classList.add('project-reveal--pending'));

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('project-reveal--visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
    );

    targets.forEach((target) => observer.observe(target));
  }

  // Preview -> collage -> full project: three views on the same page,
  // switched by the stepper, the "see the X" links, or clicking straight
  // into a collage image (which also scrolls to that same image in the
  // full project instead of just landing at the top).
  const article = document.querySelector<HTMLElement>('.project[data-has-steps]');

  if (article) {
    const views = article.querySelectorAll<HTMLElement>('.project__view');
    const stepButtons = article.parentElement?.querySelectorAll<HTMLButtonElement>('.reading-stepper button') ?? [];
    const scrollBehavior = prefersReducedMotion ? 'auto' : 'smooth';

    const showView = (step: string) => {
      views.forEach((view) => {
        view.classList.toggle('project__view--active', view.dataset.view === step);
      });
      stepButtons.forEach((button) => {
        button.setAttribute('aria-current', String(button.dataset.step === step));
      });
    };

    const goTo = (step: string) => {
      showView(step);
      window.scrollTo({ top: 0, behavior: scrollBehavior });
    };

    // A link from the Home page's Selected Work timeline already served as
    // this project's "preview" (title, cover, description), so it points
    // here with a #collage hash to skip straight past a second preview.
    showView(window.location.hash === '#collage' ? 'collage' : 'preview');

    stepButtons.forEach((button) => {
      button.addEventListener('click', () => goTo(button.dataset.step ?? 'preview'));
    });

    article.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((button) => {
      button.addEventListener('click', () => goTo(button.dataset.goto ?? 'preview'));
    });

    article.querySelectorAll<HTMLAnchorElement>('.project-collage__piece').forEach((piece) => {
      piece.addEventListener('click', (event) => {
        event.preventDefault();
        const targetId = piece.dataset.target;
        showView('full');
        if (targetId) {
          // Two frames, not one: the first lets the browser register the
          // display:none -> block swap, the second measures against the
          // now-settled layout - a single frame still sees stale (pre-swap)
          // positions and scrolls to the wrong place.
          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              document.getElementById(targetId)?.scrollIntoView({ behavior: scrollBehavior, block: 'center' });
            });
          });
        } else {
          window.scrollTo({ top: 0, behavior: scrollBehavior });
        }
      });
    });

    // The top stepper (inside the preview/collage header) is only ever
    // in view right at the top of the page. Once it scrolls out, the
    // fixed copy on the side takes over, so switching steps never
    // requires scrolling all the way back up.
    const topStepper = article.querySelector<HTMLElement>('.project__stepper');
    const fixedStepper = document.querySelector<HTMLElement>('.project__stepper-fixed');

    if (topStepper && fixedStepper && 'IntersectionObserver' in window) {
      const stepperObserver = new IntersectionObserver(
        ([entry]) => {
          fixedStepper.classList.toggle('project__stepper-fixed--visible', !entry.isIntersecting);
        },
        { threshold: 0 },
      );
      stepperObserver.observe(topStepper);
    }
  }

  // Click-to-enlarge for every image in the full project view (cover image
  // included). Preview/collage-step images aren't part of this - the
  // preview cover instead advances to the collage step (via [data-goto]
  // above), and collage images already jump into the full project.
  const lightbox = document.querySelector<HTMLElement>('#project-lightbox');
  const lightboxImg = lightbox?.querySelector<HTMLImageElement>('.lightbox__img');
  const lightboxClose = lightbox?.querySelector<HTMLButtonElement>('.lightbox__close');
  let lastFocused: HTMLElement | null = null;

  const openLightbox = (src: string, alt: string, trigger: HTMLElement) => {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
    lastFocused = trigger;
    lightboxClose?.focus();
  };

  const closeLightbox = () => {
    if (!lightbox || !lightboxImg) return;
    lightbox.hidden = true;
    lightboxImg.src = '';
    document.body.style.overflow = '';
    lastFocused?.focus();
  };

  if (lightbox && lightboxImg) {
    const fullImages = document.querySelectorAll<HTMLImageElement>('.project__cover img, .project__body img');

    fullImages.forEach((img) => {
      img.setAttribute('role', 'button');
      img.setAttribute('tabindex', '0');
      img.classList.add('project__image--enlargeable');

      const trigger = () => openLightbox(img.currentSrc || img.src, img.alt, img);
      img.addEventListener('click', trigger);
      img.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          trigger();
        }
      });
    });

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !lightbox.hidden) closeLightbox();
    });
  }

  // Videos already have their own native controls (play, seek, fullscreen);
  // clicking one just hands off to the browser's own fullscreen rather than
  // duplicating that in the image lightbox above.
  document.querySelectorAll<HTMLVideoElement>('.project__body video').forEach((video) => {
    video.addEventListener('click', () => {
      video.requestFullscreen?.().catch(() => {});
    });
  });
</script>

<style>
  .project__header {
    padding-block: var(--space-4);
  }

  .project__back {
    margin-bottom: var(--space-3);
    font-size: var(--font-size-sm);
  }

  .project__subtitle {
    margin-top: var(--space-2);
    max-width: 40rem;
    font-size: var(--font-size-lg);
    color: var(--color-muted);
  }

  .project__meta {
    margin: var(--space-4) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-4);
    padding-top: var(--space-3);
  }

  .project__meta div {
    min-width: 8rem;
  }

  .project__meta dt {
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .project__meta dd {
    margin: 0;
    margin-top: var(--space-0);
  }

  .project__cover {
    display: block;
    width: 100%;
    margin-top: var(--space-4);
  }

  .project__body {
    padding-block: var(--space-4) var(--space-5);
  }

  /*
    Text stays in a narrow, readable column. Images (placed via the
    LoadingImage component, optionally wrapped in <figure> for a
    caption, in project MDX files) are direct children of this container
    rather than nested in a paragraph, so they're unaffected by this rule
    and stay at the full container width - giving maps and diagrams with
    fine text/labels room to stay legible.
  */
  .project__body :global(h2),
  .project__body :global(h3),
  .project__body :global(p) {
    max-width: 48rem;
    margin-inline: auto;
  }

  .project__body :global(h2) {
    margin-top: var(--space-4);
    font-size: var(--font-size-2xl);
  }

  .project__body :global(h2:first-child) {
    margin-top: 0;
  }

  /*
    Matches the figure's own margin-block below, so a heading like the
    per-video titles in the Arkyv project sits with equal space above
    (from the preceding paragraph) and below (to the video/figure).
  */
  .project__body :global(h3) {
    margin-top: var(--space-4);
  }

  .project__body :global(p) {
    margin-top: var(--space-2);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-base);
  }

  .project__body :global(.loading-image) {
    display: block;
    width: 100%;
    margin-block: var(--space-4);
  }

  .project__body :global(figure) {
    margin-block: var(--space-4);
    margin-inline: 0;
    scroll-margin-top: var(--space-4);
  }

  /* Avoid doubling the spacing when a figure already owns it. */
  .project__body :global(figure .loading-image) {
    margin-block: 0;
  }

  .project__body :global(figcaption) {
    margin-top: var(--space-1);
    text-align: center;
    font-size: var(--font-size-sm);
    color: var(--color-muted);
  }

  .project__body :global(.project-reveal--pending) {
    opacity: 0;
    transform: translateY(1rem);
    transition: opacity 400ms ease-out, transform 400ms ease-out;
  }

  .project__body :global(.project-reveal--pending.project-reveal--visible) {
    opacity: 1;
    transform: none;
  }

  /* Reading-depth steps (preview / collage / full project) */

  .project[data-has-steps] .project__view {
    display: none;
  }

  .project[data-has-steps] .project__view--active {
    display: block;
  }

  .project__stepper {
    padding-top: var(--space-4);
  }

  .project__view[data-view='preview'],
  .project__view[data-view='collage'] {
    padding-block: var(--space-4) var(--space-5);
  }

  .project__view[data-view='preview'] h1,
  .project__view[data-view='collage'] h1 {
    margin-bottom: var(--space-1);
  }

  .project__preview-cover-link {
    all: unset;
    display: block;
    width: 100%;
    cursor: pointer;
  }

  .project__preview-cover {
    display: block;
    width: 100%;
    margin-top: var(--space-3);
    transition: opacity var(--transition-fast);
  }

  .project__preview-cover-link:hover .project__preview-cover,
  .project__preview-cover-link:focus-visible .project__preview-cover {
    opacity: 0.85;
  }

  .project__preview-text {
    margin-top: var(--space-3);
    max-width: 48rem;
    font-size: var(--font-size-lg);
    line-height: var(--line-height-base);
  }

  .project__view[data-view='collage'] .project__subtitle {
    max-width: 48rem;
  }

  .project__view[data-view='collage'] :global(.project-collage) {
    margin-top: var(--space-4);
  }

  .project__advance {
    all: unset;
    display: inline-block;
    margin-top: var(--space-3);
    cursor: pointer;
    font-size: var(--font-size-base);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .project__advance--collage {
    margin-top: var(--space-4);
  }

  /*
    Fully global (not just :global() on a scoped ancestor): the cover
    image is rendered inside LoadingImage.astro, which carries its own
    scope hash rather than this file's - an ancestor-qualified selector
    like `.project__cover :global(...)` silently never matches it.
  */
  :global(.project__image--enlargeable) {
    cursor: pointer;
  }
</style>

<style is:global>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    background: var(--color-background);
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__img {
    display: block;
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 0 0 1px var(--color-border);
  }

  .lightbox__close {
    all: unset;
    position: fixed;
    top: var(--space-3);
    right: var(--space-3);
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-background);
    color: var(--color-text);
    cursor: pointer;
  }

  .lightbox__close:hover,
  .lightbox__close:focus-visible {
    opacity: 0.8;
  }

  /*
    A fixed copy of the top stepper, so switching between preview,
    collage, and full project never requires scrolling all the way back
    up (or, from deep in the full project, all the way down again).
    Hidden until the top stepper scrolls out of view (see [slug].astro's
    script), and hidden outright below the breakpoint where it would
    otherwise sit inside the content gutter rather than beside it.
  */
  .project__stepper-fixed {
    position: fixed;
    left: var(--space-3);
    top: 50%;
    translate: 0 -50%;
    z-index: 60;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-fast);
  }

  .project__stepper-fixed--visible {
    opacity: 1;
    pointer-events: auto;
  }

  @media (max-width: 60rem) {
    .project__stepper-fixed {
      display: none;
    }
  }
</style>
